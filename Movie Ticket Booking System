import java.util.*;

class Movie {

    int movieId;
    String movieName;
    String language;
    double ticketPrice;

    boolean[] seats;

    Movie(int movieId, String movieName,
          String language, double ticketPrice) {

        this.movieId = movieId;
        this.movieName = movieName;
        this.language = language;
        this.ticketPrice = ticketPrice;

        seats = new boolean[30];
    }

    void displayMovie() {

        System.out.println("----------------------------");
        System.out.println("Movie ID   : " + movieId);
        System.out.println("Movie Name : " + movieName);
        System.out.println("Language   : " + language);
        System.out.println("Price      : Rs." + ticketPrice);
    }

    void displaySeats() {

        System.out.println("\nSeat Layout");

        for (int i = 0; i < seats.length; i++) {

            if (seats[i]) {
                System.out.print("[X] ");
            } else {
                System.out.print("[" + (i + 1) + "] ");
            }

            if ((i + 1) % 10 == 0) {
                System.out.println();
            }
        }
    }

    void bookTickets(Scanner sc) {

        displaySeats();

        System.out.print("\nHow many tickets? ");
        int count = sc.nextInt();

        if (count <= 0 || count > 30) {
            System.out.println("Invalid ticket count!");
            return;
        }

        int[] selectedSeats = new int[count];

        for (int i = 0; i < count; i++) {

            System.out.print("Enter seat number "
                    + (i + 1) + ": ");

            int seat = sc.nextInt();

            if (seat < 1 || seat > 30 || seats[seat - 1]) {

                System.out.println("Invalid or already booked seat!");
                return;
            }

            selectedSeats[i] = seat;
        }

        for (int seat : selectedSeats) {
            seats[seat - 1] = true;
        }

        double total = count * ticketPrice;

        System.out.println("\nBooking Successful!");
        System.out.println("Movie : " + movieName);
        System.out.println("Tickets : " + count);
        System.out.println("Total Amount : Rs." + total);
    }

    void cancelTicket(Scanner sc) {

        System.out.print("Enter seat number: ");
        int seat = sc.nextInt();

        if (seat < 1 || seat > 30) {
            System.out.println("Invalid seat!");
            return;
        }

        if (!seats[seat - 1]) {
            System.out.println("Seat is not booked.");
            return;
        }

        seats[seat - 1] = false;

        System.out.println("Ticket cancelled successfully!");
    }
}

public class MovieTicketBookingSystem {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        ArrayList<Movie> movies = new ArrayList<>();

        movies.add(new Movie(
                1, "Adventure World", "English", 200));

        movies.add(new Movie(
                2, "Love Story", "Telugu", 180));

        movies.add(new Movie(
                3, "Action Hero", "Hindi", 220));

        while (true) {

            System.out.println("\n==============================");
            System.out.println("    MOVIE TICKET BOOKING");
            System.out.println("==============================");

            System.out.println("1. View Movies");
            System.out.println("2. Book Tickets");
            System.out.println("3. Cancel Ticket");
            System.out.println("4. View Seats");
            System.out.println("5. Exit");

            System.out.print("Enter choice: ");
            int choice = sc.nextInt();

            switch (choice) {

                case 1:

                    for (Movie movie : movies) {
                        movie.displayMovie();
                    }

                    break;

                case 2:

                    System.out.print("Enter Movie ID: ");
                    int movieId = sc.nextInt();

                    for (Movie movie : movies) {

                        if (movie.movieId == movieId) {
                            movie.bookTickets(sc);
                        }
                    }

                    break;

                case 3:

                    System.out.print("Enter Movie ID: ");
                    int cancelId = sc.nextInt();

                    for (Movie movie : movies) {

                        if (movie.movieId == cancelId) {
                            movie.cancelTicket(sc);
                        }
                    }

                    break;

                case 4:

                    System.out.print("Enter Movie ID: ");
                    int seatId = sc.nextInt();

                    for (Movie movie : movies) {

                        if (movie.movieId == seatId) {
                            movie.displaySeats();
                        }
                    }

                    break;

                case 5:

                    System.out.println("Thank you!");
                    sc.close();
                    return;

                default:

                    System.out.println("Invalid choice!");
            }
        }
    }
}